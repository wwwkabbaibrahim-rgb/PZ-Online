rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    function isSuspended(uid) {
      return exists(/databases/$(database)/documents/suspensions/$(uid))
        && get(/databases/$(database)/documents/suspensions/$(uid)).data.suspended == true;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && !isSuspended(request.auth.uid);
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.get('featured', false) == resource.data.get('featured', false))
        || (request.auth != null
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.title == resource.data.title
          && request.resource.data.price == resource.data.price
          && request.resource.data.category == resource.data.category
          && request.resource.data.location == resource.data.location
          && request.resource.data.description == resource.data.description
          && request.resource.data.sellerName == resource.data.sellerName
          && request.resource.data.sellerPhone == resource.data.sellerPhone
          && request.resource.data.image == resource.data.image
          && request.resource.data.images == resource.data.images
          && request.resource.data.get('status','available') == resource.data.get('status','available')
          && request.resource.data.views == resource.data.get('views',0) + 1);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    match /suspensions/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /verifiedSellers/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/favorites/{listingId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/blockedUsers/{blockedId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/savedSearches/{searchId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.participants);
      allow create: if isAdmin() || (request.auth != null && request.auth.uid in request.resource.data.participants);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.participants);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create: if isAdmin()
          || (request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && request.resource.data.senderId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.listingId != null
        && request.resource.data.revieweeId != null;
      allow update: if request.auth != null && resource.data.reviewerId == request.auth.uid;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.reviewerId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId != null;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }
  }
}
